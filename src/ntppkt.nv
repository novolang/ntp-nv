// ntppkt.nv — the forty-eight bytes, and the two fixed-point scales
// they mix.
//
// `[]` THROUGHOUT, AND `@tier(embedded)` ON THE ARITHMETIC.  A sensor
// with a radio and no battery-backed clock is the consumer that makes
// this claim real: it holds forty-eight bytes and does integer
// arithmetic over them, and it cannot link anything that allocates.
// `tests/embedded_probe.nv` is that claim as a program.
//
// TWO FIXED-POINT SCALES IN ONE PACKET, AND THIS IS WHERE THEY ARE
// KEPT APART.  The four timestamps are 32.32 — whole seconds in the
// high half, units of 2^-32 seconds in the low half.  Root delay and
// root dispersion are 16.16, in units of 2^-16 seconds.  A codec that
// used one scale for both is out by a factor of 65536, which on root
// dispersion reads as "this server is eighteen hours wrong" or "this
// server is perfect", depending on the direction, and neither looks
// like a units bug.
//
// A DECODE THAT CAN FAIL ANSWERS THE PACKET, NOT A `Result` OF ONE.
// A `@value` struct crosses a `Result` payload by boxing a copy of
// itself — an allocation — and at `@tier(embedded)` a payload-carrying
// `Result` is refused outright.  So `is_wellformed` is the gate a
// caller runs first, `decode` reads the bytes it was given, and
// `packet_fault` says what is wrong with the packet that came out.
// That is the shape a device wants: the packet lives in the caller's
// frame and nothing is allocated to parse it.

use std.str
use ntpfault

// The wire size of an NTP packet without extensions or a MAC.
pub const NTP_PACKET_BYTES = 48

// The service port.
pub const NTP_PORT = 123

// The version this package writes.  Version 3 is accepted on the way
// in, because a pool still contains servers that answer it.
pub const NTP_VERSION = 4

// Mode 3: a client asking.
pub const NTP_MODE_CLIENT = 3

// Mode 4: a server answering.  A reply in any other mode is refused —
// see `NtpFaultNotAServerReply`.
pub const NTP_MODE_SERVER = 4

// Seconds between 1900-01-01 and 1970-01-01: the NTP epoch and the Unix
// epoch, seventy years and seventeen leap days apart.
pub const NTP_UNIX_EPOCH_DELTA = 2208988800

// The highest stratum that means anything.  16 is "unsynchronised" and
// anything above is reserved.
pub const NTP_MAX_STRATUM = 15

// One NTP timestamp: seconds and a fraction of a second.
//
// A `@value` struct, so it lives in the caller's frame with no header
// and no allocation — a client that keeps four of these keeps
// sixty-four bytes.
pub @value
struct NtpTimestamp
    // Seconds since the NTP epoch, as the 32-bit field carries them.
    // NOT a count that keeps growing: see `ntpcalc.unix_seconds_of` and
    // era rule, because this field wraps in 2036.
    seconds: Int
    // Units of 2^-32 seconds: one count is about 233 picoseconds, and
    // the whole field is just under one second.
    fraction: Int

// One NTP packet, decoded.
//
// A `@value` struct: forty-eight bytes of wire become a value in the
// caller's frame, which is what a device needs and what makes a whole
// exchange a test with no allocator in it.
pub @value
struct NtpPacket
    // 0 no warning, 1 last minute has 61 seconds, 2 it has 59, 3 the
    // server's clock is NOT SYNCHRONISED.  Three is the one that
    // matters: it is a refusal written in two bits.
    leap: Int
    version: Int
    mode: Int
    // 1 is a primary reference (a radio clock), 2..15 are secondary,
    // and 0 is a KISS-O'-DEATH packet whose reference id is four
    // characters of instruction.
    stratum: Int
    // The poll interval as a signed power of two seconds.
    poll: Int
    // The clock precision as a signed power of two seconds.  Typically
    // negative and around -20 on a machine with a microsecond clock.
    precision: Int
    // Total round-trip delay to the primary reference, 16.16 fixed
    // point in units of 2^-16 seconds.
    root_delay: Int
    // Maximum error relative to the primary reference, same scale.
    // With `root_delay` this is what says how wrong the server may be,
    // and a client that read neither accepts a stratum-15 server that
    // is a minute out.
    root_dispersion: Int
    // Four bytes.  A four-character source name at stratum 1, an IPv4
    // address or a hash at higher strata, and a KISS CODE at stratum 0.
    // Kept as one big-endian integer because a `@value` struct cannot
    // own a buffer; `reference_text` is the four characters.
    reference_id: Int
    // When the server's clock was last set.
    reference_time: NtpTimestamp
    // T1: when the client sent its request, AS THE CLIENT WROTE IT.
    // The server copies it back, so this is the client's nonce — see
    // `ntpcalc.check`.
    originate: NtpTimestamp
    // T2: when the request reached the server.
    receive: NtpTimestamp
    // T3: when the server sent this reply.
    transmit: NtpTimestamp

// THE BYTE READER AND WRITER, AND WHY IT IS IN THIS SHAPE.  Every read
// past the end of the buffer answers zero rather than refusing, which
// is what makes `decode` total: a caller that skipped `is_wellformed`
// gets a packet whose fields are the bytes that were there and zeroes
// for the rest, and `packet_fault` refuses it.  Nothing in this block
// allocates, which is what keeps the codec at `@tier(embedded)`.
@tier(embedded)
fn get_u8(bytes: [u8], at: Int) -> Int
    if at < 0 or at >= list.len(bytes)
        0
    else
        bytes[at] as Int

@tier(embedded)
fn get_u32(bytes: [u8], at: Int) -> Int
    (get_u8(bytes, at) << 24) | (get_u8(bytes, at + 1) << 16) | (get_u8(bytes, at + 2) << 8) | get_u8(bytes, at + 3)

@tier(embedded)
fn get_timestamp(bytes: [u8], at: Int) -> NtpTimestamp
    NtpTimestamp { seconds: get_u32(bytes, at), fraction: get_u32(bytes, at + 4) }

// The write half.  `var out: [u8]` rather than `out: [u8]` because the
// write has to reach the caller's buffer and a list parameter that is
// not `var` is a copy the callee writes into and drops — see the
// CHANGELOG's `### Known` entry.
@tier(embedded)
fn put_u32(var out: [u8], at: Int, v: Int)
    out[at] = (v >> 24) & 255
    out[at + 1] = (v >> 16) & 255
    out[at + 2] = (v >> 8) & 255
    out[at + 3] = v & 255

// A byte the packet's own field says is signed, as the two signed
// fields in the header are.
@tier(embedded)
fn signed_byte(v: Int) -> Int
    if v >= 128
        v - 256
    else
        v

// The same for the two 32-bit fixed-point fields.  RFC 5905 § 7.3
// writes them signed and a client that read them unsigned answers a
// dispersion of four billion seconds for a byte pattern that means
// minus one.
@tier(embedded)
fn signed32(v: Int) -> Int
    if v >= 2147483648
        v - 4294967296
    else
        v

// Two to the power of a signed exponent field, clamped where the
// packet's scale runs out: `poll` and `precision` are signed powers of
// two seconds, and a server is free to send one no hardware can honour.
@tier(embedded)
fn pow2(exp: Int) -> Int
    if exp < 0
        0
    elif exp > 30
        1073741824
    else
        1 << exp

// Byte `i` of a reference id, high byte first.
@tier(embedded)
fn ref_byte(id: Int, i: Int) -> Int
    (id >> (24 - i * 8)) & 255

@tier(embedded)
fn printable(v: Int) -> Bool
    v >= 32 and v <= 126

// Whether a reference id is the four printable characters that make it
// a code.  Stratum 0 with a zero reference id is a request, or a server
// answering "unspecified", and neither is a kiss-o'-death: the code
// field is four ASCII characters or it is not a code.
@tier(embedded)
fn ref_is_text(id: Int) -> Bool
    printable(ref_byte(id, 0)) and printable(ref_byte(id, 1)) and printable(ref_byte(id, 2)) and printable(ref_byte(id, 3))

// The four characters of a reference id, at the tier that can build a
// `Str`.  A function of its own rather than a join written at the call
// site, because a `+` join written inside a match arm leaks a cell
// whether or not the arm is taken.
@tier(rt)
fn four_chars(id: Int) -> Str
    str.from_byte(ref_byte(id, 0)) + str.from_byte(ref_byte(id, 1)) + str.from_byte(ref_byte(id, 2)) + str.from_byte(ref_byte(id, 3))

@tier(rt)
fn kiss_from_id(id: Int) -> NtpKiss
    ntpfault.kiss_of_text(four_chars(id))

// A timestamp from its two halves.
//
// ```novo
// use ntppkt
//
// fn t(s: Int, f: Int) -> NtpTimestamp
//     ntppkt.timestamp(s, f)
// ```
pub @tier(embedded)
fn timestamp(seconds: Int, fraction: Int) -> NtpTimestamp []
    NtpTimestamp { seconds: seconds, fraction: fraction }

// The zero timestamp, which means "no time at all".
//
// Not an absence to paper over: a reply whose transmit timestamp is
// this is a server that answered without having a time to give, and
// `ntpcalc.check` refuses it.
pub @tier(embedded)
fn zero_timestamp() -> NtpTimestamp []
    NtpTimestamp { seconds: 0, fraction: 0 }

// Whether two timestamps are the same sixty-four bits.
//
// The comparison the anti-spoofing check is: the reply's originate
// field against the transmit field the client sent.  Both halves, and
// nothing approximate about it.
pub @tier(embedded)
fn timestamp_eq(a: NtpTimestamp, b: NtpTimestamp) -> Bool []
    a.seconds == b.seconds and a.fraction == b.fraction

// Whether a timestamp is the zero one.
pub @tier(embedded)
fn timestamp_is_zero(t: NtpTimestamp) -> Bool []
    t.seconds == 0 and t.fraction == 0

// A client request, carrying the caller's nonce as its transmit
// timestamp.
//
// THE NONCE IS AN ARGUMENT AND THAT IS THE DESIGN.  RFC 4330 § 3 says
// to put an unpredictable value in this field, because the server
// copies it into the reply's originate field and comparing the two is
// the only thing that stops an off-path attacker from answering first.
// A `core`-shaped module has no randomness, so the caller supplies it —
// and a caller that passes a counter, or the current time, has an SNTP
// client with no anti-spoofing at all.  The README says so where
// somebody about to do it will read it.
pub @tier(embedded)
fn request(nonce: NtpTimestamp) -> NtpPacket []
    NtpPacket {
        leap: 0,
        version: NTP_VERSION,
        mode: NTP_MODE_CLIENT,
        stratum: 0,
        poll: 0,
        precision: 0,
        root_delay: 0,
        root_dispersion: 0,
        reference_id: 0,
        reference_time: zero_timestamp(),
        originate: zero_timestamp(),
        receive: zero_timestamp(),
        transmit: nonce }

// Write a packet into a caller's buffer.
//
// Forty-eight bytes, big-endian throughout.  Answers how many bytes
// were written, or zero when the buffer is too small — a device sizes
// its buffer once and this is the check that it did.
pub @tier(embedded)
fn encode_into(var out: [u8], at: Int, p: NtpPacket) -> Int []
    if at < 0 or list.len(out) < at + NTP_PACKET_BYTES
        0
    else
        out[at] = ((p.leap & 3) << 6) | ((p.version & 7) << 3) | (p.mode & 7)
        out[at + 1] = p.stratum & 255
        out[at + 2] = p.poll & 255
        out[at + 3] = p.precision & 255
        put_u32(out, at + 4, p.root_delay)
        put_u32(out, at + 8, p.root_dispersion)
        put_u32(out, at + 12, p.reference_id)
        put_u32(out, at + 16, p.reference_time.seconds)
        put_u32(out, at + 20, p.reference_time.fraction)
        put_u32(out, at + 24, p.originate.seconds)
        put_u32(out, at + 28, p.originate.fraction)
        put_u32(out, at + 32, p.receive.seconds)
        put_u32(out, at + 36, p.receive.fraction)
        put_u32(out, at + 40, p.transmit.seconds)
        put_u32(out, at + 44, p.transmit.fraction)
        NTP_PACKET_BYTES

// Whether these bytes can be decoded at all.
//
// Length and version only.  Everything else a client must check is a
// property of the reply rather than of the bytes, and `ntpcalc.check`
// is where those live.
pub @tier(embedded)
fn is_wellformed(bytes: [u8], at: Int, len: Int) -> Bool []
    if at < 0 or len < NTP_PACKET_BYTES
        false
    elif at + NTP_PACKET_BYTES > list.len(bytes)
        false
    else
        let version = (get_u8(bytes, at) >> 3) & 7
        version == 3 or version == 4

// Decode forty-eight bytes.
//
// Answers the packet it read, which for malformed input is a packet
// whose fields are whatever the bytes said.  `is_wellformed` is the
// gate, and the two are separate because a `Result` carrying this
// `@value` struct would box a copy of it — an allocation, and one the
// embedded tier refuses — and a boxed packet is one a device cannot
// hold.
pub @tier(embedded)
fn decode(bytes: [u8], at: Int) -> NtpPacket []
    let b0 = get_u8(bytes, at)
    NtpPacket {
        leap: (b0 >> 6) & 3,
        version: (b0 >> 3) & 7,
        mode: b0 & 7,
        stratum: get_u8(bytes, at + 1),
        poll: signed_byte(get_u8(bytes, at + 2)),
        precision: signed_byte(get_u8(bytes, at + 3)),
        root_delay: signed32(get_u32(bytes, at + 4)),
        root_dispersion: signed32(get_u32(bytes, at + 8)),
        reference_id: get_u32(bytes, at + 12),
        reference_time: get_timestamp(bytes, at + 16),
        originate: get_timestamp(bytes, at + 24),
        receive: get_timestamp(bytes, at + 32),
        transmit: get_timestamp(bytes, at + 40) }

// The fault a packet's own fields imply, before any timing is
// considered.
//
// Mode, version, leap indicator, stratum and the zero transmit
// timestamp: the five checks that do not need the client's request.
// `ntpcalc.check` adds the one that does.
pub @tier(rt)
fn packet_fault(p: NtpPacket) -> ?NtpFault []
    if p.mode != NTP_MODE_SERVER
        Some(NtpFaultNotAServerReply(p.mode))
    elif p.version < 3 or p.version > 4
        Some(NtpFaultBadVersion(p.version))
    elif p.leap == 3
        Some(NtpFaultUnsynchronised)
    elif p.stratum == 0
        Some(NtpFaultKiss(kiss_from_id(p.reference_id)))
    elif p.stratum > NTP_MAX_STRATUM
        Some(NtpFaultBadStratum(p.stratum))
    elif timestamp_is_zero(p.transmit)
        Some(NtpFaultZeroTransmit)
    else
        None

// The four characters of a stratum-0 reply's reference id.
pub @tier(rt)
fn reference_text(p: NtpPacket) -> Str []
    four_chars(p.reference_id)

// The kiss code a stratum-0 reply carries, when it is one.
//
// ```novo
// use ntpfault
// use ntppkt
//
// fn kiss(p: NtpPacket) -> ?NtpKiss
//     ntppkt.kiss_of(p)
// ```
pub @tier(rt)
fn kiss_of(p: NtpPacket) -> ?NtpKiss []
    if is_kiss(p)
        Some(kiss_from_id(p.reference_id))
    else
        None

// Whether a packet is a kiss-o'-death.
pub @tier(embedded)
fn is_kiss(p: NtpPacket) -> Bool []
    p.stratum == 0 and ref_is_text(p.reference_id)

// Root delay in microseconds.
//
// The 16.16 scale converted once, here, so that nothing else in this
// package has to remember which of the two scales this field is in.
pub @tier(embedded)
fn root_delay_micros(p: NtpPacket) -> Int []
    p.root_delay * 1000000 / 65536

// Root dispersion in microseconds.
pub @tier(embedded)
fn root_dispersion_micros(p: NtpPacket) -> Int []
    p.root_dispersion * 1000000 / 65536

// The server's own worst-case error, in microseconds.
//
// `root_dispersion + root_delay / 2`, which is RFC 5905's own
// expression for how far from the primary reference this server may be.
// A client that read the stratum and stopped accepts a stratum-15
// server that is a minute out, because the stratum says how many hops
// and not how wrong.
pub @tier(embedded)
fn server_error_micros(p: NtpPacket) -> Int []
    root_dispersion_micros(p) + root_delay_micros(p) / 2

// The poll interval in seconds, from the signed power of two.
pub @tier(embedded)
fn poll_seconds(p: NtpPacket) -> Int []
    pow2(p.poll)

// The clock precision in microseconds, from the signed power of two.
pub @tier(embedded)
fn precision_micros(p: NtpPacket) -> Int []
    if p.precision >= 0
        pow2(p.precision) * 1000000
    elif p.precision < -30
        1
    else
        (1000000 + (1 << (0 - p.precision)) - 1) / (1 << (0 - p.precision))
